[Unit]
Description=Result Portal (Flask app served by gunicorn)
After=network.target

[Service]
User=portal
Group=portal
WorkingDirectory=/opt/result-portal
ExecStart=/opt/result-portal/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 app:app
Restart=always
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
