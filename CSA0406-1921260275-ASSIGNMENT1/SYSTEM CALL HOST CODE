#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

long copy_file(const char *src, const char *dst, size_t bufsize)
{
    char buf[8192];
    int in = open(src, O_RDONLY);
    if (in < 0) return -1;
    int out = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (out < 0) {
        close(in);
        return -1;
    }

    long calls = 0;
    ssize_t n;

    if (bufsize == 0 || bufsize > sizeof buf) {
        close(in);
        close(out);
        return -1;
    }

    while (1) {
        n = read(in, buf, bufsize);
        calls++;

        if (n == 0) break;
        if (n < 0) {
            calls = -1;
            break;
        }

        ssize_t written = 0;
        while (written < n) {
            ssize_t w = write(out, buf + written, (size_t)(n - written));
            if (w <= 0) {
                calls = -1;
                break;
            }
            written += w;
        }

        if (calls < 0) break;
    }

    close(in);
    close(out);
    return calls;
}

int main(void)
{
    FILE *f = fopen("records.dat", "w");
    if (!f) return 1;

    for (int i = 0; i < 10000; i++)
        fputc('A' + i % 26, f);

    fclose(f);

    size_t sizes[] = {1, 512, 4096};

    for (int i = 0; i < 3; i++)
        printf("buffer %4zu bytes: %5ld read() calls\n",
               sizes[i], copy_file("records.dat", "copy.dat", sizes[i]));

    unlink("records.dat");
    unlink("copy.dat");
    return 0;
}
