
#include <stdio.h>

int main() {
    int n,bu[10],tat[10],wt[10],t_tat=0, t_wt=0, i, p[10],t,j;
    float avg_tat, avg_wt;
    printf("\nEnter no.of process: ");
    scanf("%d", &n);
    printf("Enter Burst Time value: \n");
    for(i=0;i<n;i++){
        scanf("%d", &bu[i]);
        p[i]=i+1;
    }

    for(i=0; i<n-1;i++)
    {
        for(j=i+1;j<n;j++)
            {
                if(bu[i]>bu[j])
                {
                    t=bu[i];
                    bu[i]=bu[j];
                    bu[j]=t;
                    t=p[i];
                    p[i]=p[j];
                    p[j]=t;
                }}}
    wt[0]=0;
    for(i=1;i<n;i++){
        wt[i]=wt[i-1]+bu[i-1];
    }
    for (i=0;i<n;i++){
        tat[i]=bu[i]+wt[0];
        t_tat += tat [i];
        t_wt += wt[i];
    }
    avg_tat=(float) t_tat/n;
    avg_wt=(float) t_wt/n;
    printf("\n Average turn around time %f",avg_tat);
    printf("\n Average waiting time is %f", avg_wt);
}
