#include <stdio.h>

int main()
{
    int n, bt[10], tat[10], wt[10], t_tat = 0, t_wt = 0, i, P[10];
    float avg_tat, avg_wt;

    printf("\nEnter the no. of process:");
    scanf("%d", &n);

    printf("Enter burst time value one by one:\n");

    for (i = 0; i < n; i++)
    {
        scanf("%d", &bt[i]);
        P[i] = i + 1;
    }

    wt[0] = 0;

    for (i = 1; i < n; i++)
    {
        wt[i] = wt[i - 1] + bt[i - 1];
    }

    for (i = 0; i < n; i++)
    {
        tat[i] = bt[i] + wt[i];
        t_tat += tat[i];
        t_wt += wt[i];
    }

    avg_tat = (float)t_tat / n;
    avg_wt = (float)t_wt / n;

    printf("\nThe average Turn around time is : %f", avg_tat);
    printf("\nThe average waiting time is : %f", avg_wt);

    printf("\nProcess\t\tTurn Around Time\tWaiting Time");

    for (i = 0; i < n; i++)
    {
        printf("\nP%d\t\t%d\t\t%d", P[i], tat[i], wt[i]);
    }

    return 0;
}
