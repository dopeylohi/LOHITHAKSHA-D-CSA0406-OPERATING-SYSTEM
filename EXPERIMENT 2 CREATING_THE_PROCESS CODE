#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    pid_t pid;
    int n, s = 0, fact = 1, i;

    pid = fork();

    if (pid < 0)
    {
        printf("Not able to create the process");
    }
    else if (pid == 0)
    {
        printf("Enter the number to find factorial:");
        scanf("%d", &n);

        for (i = 1; i <= n; i++)
        {
            fact *= i;
        }

        printf("The factorial is : %d", fact);
    }
    else
    {
        printf("Enter the n value:");
        scanf("%d", &n);

        for (i = 1; i <= n; i++)
        {
            s += i;
        }

        printf("The sum of %d numbers is %d", n, s);

        wait(NULL);
    }

    return 0;
}
